#!/bin/sh
set -eu
if [ "$1" = upgrade ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop microvm-mcp.service
    state=$(systemctl show --property=ActiveState --value microvm-mcp.service)
    case "$state" in
        inactive|failed) ;;
        *) echo "microvm-mcp is still active; stop it before upgrading Firecracker" >&2; exit 1 ;;
    esac
fi
#DEBHELPER#
