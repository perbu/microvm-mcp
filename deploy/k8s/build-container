#!/usr/bin/env bash
# Build the Kubernetes container image from packages produced by scripts/build-debs.
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
root=$(cd -- "$here/../.." && pwd)
tag=${1:?usage: deploy/k8s/build-container IMAGE:TAG [PACKAGE_DIR]}
packages=$(realpath "${2:-$root/dist/debian}")
docker build --build-context "debs=$packages" -t "$tag" -f "$here/Dockerfile" "$here"
